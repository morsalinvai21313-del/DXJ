        <item name="android:statusBarColor">@color/cyber_bg_primary</item>
        <item name="android:navigationBarColor">@color/cyber_bg_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/cyber_cyan</item>
        <item name="colorSecondary">@color/cyber_green</item>
        <item name="colorSurface">@color/cyber_surface</item>
