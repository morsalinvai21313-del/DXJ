<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4D00F0FF">
    <item>
        <selector>
            <item android:state_pressed="true">
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <solid android:color="#4000F0FF" />
                            <stroke android:width="2dp" android:color="@color/cyber_cyan" />
                            <corners android:radius="8dp" />
                        </shape>
                    </item>
                    <item android:top="2dp" android:bottom="2dp" android:left="3dp" android:right="3dp">
                        <shape android:shape="rectangle">
                            <stroke android:width="1dp" android:color="#8000F0FF" />
                            <corners android:radius="6dp" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item android:state_focused="true">
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <solid android:color="#2A00F0FF" />
                            <stroke android:width="2dp" android:color="@color/cyber_cyan" />
                            <corners android:radius="8dp" />
                        </shape>
                    </item>
                    <item android:top="2dp" android:bottom="2dp" android:left="3dp" android:right="3dp">
                        <shape android:shape="rectangle">
                            <stroke android:width="1dp" android:color="#6000F0FF" />
                            <corners android:radius="6dp" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item>
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <gradient
                                android:angle="0"
                                android:startColor="#18001622"
                                android:centerColor="#28002B40"
                                android:endColor="#18001622" />
                            <stroke android:width="1.8dp" android:color="@color/cyber_cyan" />
                            <corners android:radius="8dp" />
                        </shape>
                    </item>
                    <item android:top="2.5dp" android:bottom="2.5dp" android:left="4dp" android:right="4dp">
                        <shape android:shape="rectangle">
                            <stroke android:width="1dp" android:color="#3300F0FF" />
                            <corners android:radius="5dp" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>
</ripple>
