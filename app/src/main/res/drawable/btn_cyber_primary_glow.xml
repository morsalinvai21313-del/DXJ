<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4D00F0FF">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="#3300F0FF" />
                    <stroke android:width="1.5dp" android:color="@color/cyber_cyan" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="#0F1622" />
                    <stroke android:width="1dp" android:color="#1E293B" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="0"
                        android:startColor="#1500F0FF"
                        android:endColor="#2A00F0FF" />
                    <stroke android:width="1.5dp" android:color="@color/cyber_cyan" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
