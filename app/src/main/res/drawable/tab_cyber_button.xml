<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A00F0FF" />
            <stroke android:width="1.2dp" android:color="@color/cyber_cyan" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1400F0FF" />
            <stroke android:width="1dp" android:color="@color/cyber_cyan" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0F1522" />
            <stroke android:width="1dp" android:color="#1E293B" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
