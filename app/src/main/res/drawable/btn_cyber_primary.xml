<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4000F0FF" />
            <stroke android:width="2dp" android:color="@color/cyber_cyan" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#0B1320" />
            <stroke android:width="1dp" android:color="#1A2538" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#1800F0FF"
                android:endColor="#2800F0FF" />
            <stroke android:width="1.8dp" android:color="@color/cyber_cyan" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
