<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cyber_bg_primary"
    android:fitsSystemWindows="true">

    <!-- Top Cyber App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#0A0E18">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/cyber_dex_icon_1794130983683"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CYBER DEX STUDIO"
                android:fontFamily="@font/orbitron"
                android:textColor="@color/cyber_cyan"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:id="@+id/tv_active_module_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JAVA BYTECODE TO SMALI DISASSEMBLY"
                android:fontFamily="@font/jetbrains_mono"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="10sp"
                android:letterSpacing="0.02" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ONLINE"
            android:fontFamily="@font/jetbrains_mono"
            android:textColor="@color/cyber_green"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/badge_cyber_green" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#162032" />

    <!-- Horizontal Module Tabs Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:scrollbars="none"
        android:background="#080C16"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:id="@+id/layout_module_tabs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_java_smali"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="JAVA TO SMALI"
                android:fontFamily="@font/jetbrains_mono"
                android:textColor="@color/cyber_cyan"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/tab_cyber_button"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tab_java_dex"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="JAVA TO DEX"
                android:fontFamily="@font/jetbrains_mono"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="11sp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/tab_cyber_button"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tab_smali_dex"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="SMALI TO DEX"
                android:fontFamily="@font/jetbrains_mono"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="11sp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/tab_cyber_button"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tab_dex_smali"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="DEX TO SMALI"
                android:fontFamily="@font/jetbrains_mono"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="11sp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/tab_cyber_button"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tab_java_kt"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="JAVA TO KOTLIN"
                android:fontFamily="@font/jetbrains_mono"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="11sp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/tab_cyber_button"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tab_kt_java"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="KOTLIN TO JAVA"
                android:fontFamily="@font/jetbrains_mono"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="11sp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/tab_cyber_button"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tab_xml_layout"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="XML LAYOUT"
                android:fontFamily="@font/jetbrains_mono"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="11sp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/tab_cyber_button"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tab_xml_drawable"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="XML DRAWABLE"
                android:fontFamily="@font/jetbrains_mono"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="11sp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/tab_cyber_button" />
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#162032" />

    <!-- Dedicated Full Workspace ScrollView -->
    <ScrollView
        android:id="@+id/main_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Workspace Top Control Strip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tv_module_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JAVA TO SMALI"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textColor="@color/cyber_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:background="@drawable/badge_cyber_cyan" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Action Buttons: Clear, Sample, Open File -->
                <TextView
                    android:id="@+id/btn_action_import"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="📁 Open File"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textColor="@color/cyber_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/btn_cyber_secondary"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/btn_action_template"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="Template"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textColor="@color/cyber_text_secondary"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/btn_cyber_secondary"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/btn_action_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="Clear"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textColor="@color/cyber_text_muted"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/btn_cyber_secondary" />
            </LinearLayout>

            <!-- 1. SOURCE CODE CARD (With Cyber Cyan Border) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_cyber_surface"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tv_source_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="JAVA TO SMALI SOURCE"
                        android:fontFamily="@font/jetbrains_mono"
                        android:textColor="@color/cyber_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />

                    <TextView
                        android:id="@+id/btn_source_open_file"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:text="📁 Import File"
                        android:fontFamily="@font/jetbrains_mono"
                        android:textColor="@color/cyber_cyan"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/btn_cyber_secondary"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tv_source_stats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 lines"
                        android:fontFamily="@font/jetbrains_mono"
                        android:textColor="@color/cyber_cyan"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Loaded File Banner (Shows when picked from device storage) -->
                <LinearLayout
                    android:id="@+id/layout_loaded_file_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/badge_loaded_file"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tv_loaded_file_info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📁 LOADED: classes.dex (48.2 KB)"
                        android:fontFamily="@font/jetbrains_mono"
                        android:textColor="@color/cyber_cyan"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_reset_loaded_file"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✕ Revert"
                        android:fontFamily="@font/jetbrains_mono"
                        android:textColor="@color/cyber_error"
                        android:textSize="11sp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_source_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="7"
                    android:maxLines="14"
                    android:gravity="top|start"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/cyber_text_primary"
                    android:textColorHint="@color/cyber_text_muted"
                    android:hint="Enter source code here or open file..."
                    android:padding="12dp"
                    android:background="@drawable/edit_text_cyber"
                    android:scrollbars="vertical"
                    android:scrollHorizontally="true"
                    android:inputType="textMultiLine|textNoSuggestions" />
            </LinearLayout>

            <!-- 2. PRIMARY ACTION BUTTON (Neon Cyan Border, Glowing) -->
            <TextView
                android:id="@+id/btn_primary_action"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="CONVERT TO SMALI"
                android:fontFamily="@font/orbitron"
                android:textColor="@color/cyber_cyan"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/btn_cyber_primary"
                android:layout_marginBottom="12dp" />

            <!-- 3. HACKER TERMINAL CONSOLE (Initially GONE, appears with typing animation upon execute) -->
            <LinearLayout
                android:id="@+id/layout_terminal_console"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_terminal_console"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <View
                        android:id="@+id/terminal_dot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/badge_cyber_green"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SYSTEM ACTIVE // DALVIK TERMINAL"
                        android:fontFamily="@font/jetbrains_mono"
                        android:textColor="@color/cyber_green"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />

                    <ProgressBar
                        android:id="@+id/terminal_progress"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/cyber_green" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_terminal_logs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="[SYS:INIT] COMPILER MATRIX ONLINE..."
                    android:fontFamily="@font/jetbrains_mono"
                    android:textColor="@color/cyber_green"
                    android:textSize="11sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- 4. OUTPUT ARTIFACT CARD (Initially GONE, appears after execution with Copy, Download & Share) -->
            <LinearLayout
                android:id="@+id/layout_output_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_cyber_surface_cyan"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tv_output_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="OUTPUT ARTIFACT"
                        android:fontFamily="@font/jetbrains_mono"
                        android:textColor="@color/cyber_cyan"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />

                    <!-- Preview Mode Tabs (For XML Layout & XML Drawable) -->
                    <LinearLayout
                        android:id="@+id/layout_preview_tabs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:id="@+id/btn_tab_code"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:text="Code"
                            android:fontFamily="@font/jetbrains_mono"
                            android:textColor="@color/cyber_cyan"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/tab_cyber_button"
                            android:layout_marginEnd="4dp" />

                        <TextView
                            android:id="@+id/btn_tab_preview"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:text="Preview"
                            android:fontFamily="@font/jetbrains_mono"
                            android:textColor="@color/cyber_text_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/tab_cyber_button" />
                    </LinearLayout>

                    <!-- 1. Copy Button -->
                    <TextView
                        android:id="@+id/btn_copy_output"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="Copy"
                        android:fontFamily="@font/jetbrains_mono"
                        android:textColor="@color/cyber_cyan"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/btn_cyber_secondary"
                        android:layout_marginEnd="6dp" />

                    <!-- 2. Download to Phone Storage Button -->
                    <TextView
                        android:id="@+id/btn_download_output"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="Download"
                        android:fontFamily="@font/jetbrains_mono"
                        android:textColor="@color/cyber_green"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/btn_cyber_accent"
                        android:layout_marginEnd="6dp" />

                    <!-- 3. Direct Share Button -->
                    <TextView
                        android:id="@+id/btn_share_output"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="Share"
                        android:fontFamily="@font/jetbrains_mono"
                        android:textColor="@color/cyber_cyan"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/btn_cyber_share" />
                </LinearLayout>

                <!-- Output Code Editor -->
                <EditText
                    android:id="@+id/et_output_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="7"
                    android:maxLines="16"
                    android:gravity="top|start"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/cyber_text_primary"
                    android:textColorHint="@color/cyber_text_muted"
                    android:hint="Artifact output will appear here..."
                    android:padding="12dp"
                    android:background="@drawable/edit_text_cyber"
                    android:scrollbars="vertical"
                    android:scrollHorizontally="true"
                    android:inputType="textMultiLine|textNoSuggestions" />

                <!-- Live Visual Preview Container (XML Layout / XML Drawable) -->
                <LinearLayout
                    android:id="@+id/layout_visual_preview_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_preview_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LIVE NATIVE RENDER PREVIEW"
                        android:fontFamily="@font/orbitron"
                        android:textColor="@color/cyber_green"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="8dp" />

                    <FrameLayout
                        android:id="@+id/container_live_preview"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:background="@drawable/card_preview_surface"
                        android:padding="14dp"
                        android:foregroundGravity="center" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
