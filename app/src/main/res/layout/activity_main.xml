<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#02060C"
    android:fitsSystemWindows="true">

    <!-- The Full Cyber Dex Studio Visual matching Screenshot 2 (No status bar, no softkeys) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_cyber_home_full"
        android:contentDescription="@string/app_name" />

    <!-- Clickable Interactive Target Overlay perfectly mapped to the 8 Cyber Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="1720">

        <!-- Top Header & Hero Hacker Artwork Region (0 to 680 in 1720 coordinates) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="680" />

        <!-- 1. JAVA TO SMALI (center ~745, height ~110) -->
        <View
            android:id="@+id/btn_menu_java_to_smali"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="110"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/btn_cyber_ripple_overlay"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/module_java_smali" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="10" />

        <!-- 2. JAVA TO DEX (center ~865) -->
        <View
            android:id="@+id/btn_menu_java_to_dex"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="110"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/btn_cyber_ripple_overlay"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/module_java_dex" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="10" />

        <!-- 3. SMALI TO DEX (center ~985) -->
        <View
            android:id="@+id/btn_menu_smali_to_dex"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="110"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/btn_cyber_ripple_overlay"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/module_smali_dex" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="10" />

        <!-- 4. DEX TO SMALI (center ~1105) -->
        <View
            android:id="@+id/btn_menu_dex_to_smali"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="110"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/btn_cyber_ripple_overlay"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/module_dex_smali" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="10" />

        <!-- 5. JAVA TO KOTLIN (center ~1225) -->
        <View
            android:id="@+id/btn_menu_java_to_kotlin"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="110"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/btn_cyber_ripple_overlay"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/module_java_kotlin" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="10" />

        <!-- 6. KOTLIN TO JAVA (center ~1345) -->
        <View
            android:id="@+id/btn_menu_kotlin_to_java"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="110"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/btn_cyber_ripple_overlay"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/module_kotlin_java" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="10" />

        <!-- 7. XML LAYOUT EDITOR (center ~1465) -->
        <View
            android:id="@+id/btn_menu_xml_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="110"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/btn_cyber_ripple_overlay"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/module_xml_layout" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="10" />

        <!-- 8. XML DRAWABLE EDITOR (center ~1585) -->
        <View
            android:id="@+id/btn_menu_xml_drawable"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="110"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/btn_cyber_ripple_overlay"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/module_xml_drawable" />

        <!-- Bottom Cyber Console Base Trim Region (1640 to 1720) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="80" />

    </LinearLayout>

</FrameLayout>
